{
  "name": "ewenn-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "clean": "node scripts/clean.mjs",
    "preview": "vite preview",
